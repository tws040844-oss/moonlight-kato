                android:width="1dp"
                android:color="#FF9BEF74" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B6068" />
            <stroke
                android:width="1dp"
                android:color="#CCFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E633363C" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
