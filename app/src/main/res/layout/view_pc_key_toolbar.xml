<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="KeyboardInaccessibleWidget">

    <TextView
        android:id="@+id/pc_key_collapsed_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_pc_key_button_accent"
        android:clickable="true"
        android:contentDescription="@string/pc_key_toolbar_pc_description"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:text="@string/pc_key_toolbar_pc"
        android:textColor="#FF102010"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/pc_key_expanded_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pc_key_panel"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/pc_key_primary_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:fillViewport="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/pc_key_primary_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pc_key_keyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_keyboard_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="72dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_keyboard"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_win"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button_accent"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_win_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_win"
                    android:textColor="#FF102010"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_escape"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_escape_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_escape"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_tab"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_tab_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_tab"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_left"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_left_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_left"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_up"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_up_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_up"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_down"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_down_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_down"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_right"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_right_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_right"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_shortcuts"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_shortcuts_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="80dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_shortcuts"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_collapse"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_collapse_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:text="@string/pc_key_toolbar_collapse"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/pc_key_secondary_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fadeScrollbars="false"
            android:fillViewport="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pc_key_secondary_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pc_key_shortcut_win_e"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_shortcut_win_e_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="68dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_shortcut_win_e"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_shortcut_win_r"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_shortcut_win_r_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="68dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_shortcut_win_r"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_shortcut_previous_window"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_shortcut_previous_window_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="112dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_shortcut_previous_window"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_shortcut_task_manager"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_shortcut_task_manager_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="104dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_shortcut_task_manager"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pc_key_hide_session"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pc_key_button"
                    android:clickable="true"
                    android:contentDescription="@string/pc_key_toolbar_hide_session_description"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:minWidth="120dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pc_key_toolbar_hide_session"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</merge>
